baseURL = "{{ .project.base_url }}"
languageCode = "en-us"
title = "{{ default .project.name .project.title }}"

[module]
  [[module.imports]]
    path = "github.com/imfing/hextra"

[params]
  description = "{{ .project.tagline }}"
  projectSlug = "{{ .project.name }}"
{{- with .content_types }}{{- with .papers }}
  papersDossierDir = "{{ .dossier_dir }}"
{{- with .dossier_base_url }}
  papersDossierBaseURL = "{{ . }}"
{{- end }}
{{- end }}{{- end }}

  [params.seriesIndex]
    style = "{{ with .series_index }}{{ .style | default "cards" }}{{ else }}cards{{ end }}"

  [params.imageOptimize]
    enabled = {{ with .image }}{{ with .optimize }}{{ .enabled | default false }}{{ else }}false{{ end }}{{ else }}false{{ end }}
    format = "{{ with .image }}{{ with .optimize }}{{ .format | default "webp" }}{{ else }}webp{{ end }}{{ else }}webp{{ end }}"
    quality = {{ with .image }}{{ with .optimize }}{{ .quality | default 82 }}{{ else }}82{{ end }}{{ else }}82{{ end }}
    maxWidth = {{ with .image }}{{ with .optimize }}{{ .max_width | default 1600 }}{{ else }}1600{{ end }}{{ else }}1600{{ end }}
    bannerMaxWidth = {{ with .image }}{{ with .optimize }}{{ .banner_max_width | default 2560 }}{{ else }}2560{{ end }}{{ else }}2560{{ end }}

  [params.navbar]
    displayTitle = true
    displayLogo = false

  [params.footer]
    displayPoweredBy = false

  [params.editURL]
    enable = false

  [params.search]
    enable = true
    type = "flexsearch"
    [params.search.flexsearch]
      index = "content"

# `series` must be a taxonomy or Hextra's opengraph partial fails on
# series-tagged pages (`first 6 $series.Pages`). capabilities/references
# back the papers content-type's cross-referencing.
# Hextra's home feed (layouts/list.rss.xml) lists `params.rss.sections`, whose
# theme default is ["blog"] — a section no blog-craft blog has, so the feed was
# empty. Posts live under content/docs/<series>/.
[params.rss]
  sections = ["docs"]

# Pin the mermaid bundle Hextra fetches at build time (_partials/scripts/mermaid.html
# GetRemotes `mermaid@latest` by default, so diagram layout floated between builds:
# mermaid 11.17 pushed 8 of frank's 186 diagrams past the 1400px width gate with
# no diagram edits — frank#787). Bump deliberately, rebuild, and re-run
# validate_mermaid_layout.mjs; never `latest`. imageZoom / asciinema / katex have
# the same `@latest` default in Hextra if a blog turns them on.
[params.mermaid]
  base = "https://cdn.jsdelivr.net/npm/mermaid@11.16.1/dist"

[taxonomies]
  series = "series"
  capabilities = "capabilities"
  references = "references"

{{ $n := len .series -}}
{{ range $i, $s := .series -}}
[[menu.main]]
  name = "{{ $s.title }}"
  pageRef = "/docs/{{ $s.key }}"
  weight = {{ add $i 1 }}

{{ end -}}
[[menu.main]]
  name = "Search"
  weight = {{ add $n 1 }}
  [menu.main.params]
    type = "search"
{{ with .project.repo_url }}
[[menu.main]]
  name = "GitHub"
  url = "{{ . }}"
  weight = {{ add $n 2 }}
  [menu.main.params]
    icon = "github"
{{ end -}}

[markup]
  [markup.goldmark]
    [markup.goldmark.renderer]
      unsafe = true
  [markup.highlight]
    codeFences = true
    lineNos = false
    style = "monokai"

[outputs]
  home = ["HTML", "RSS", "JSON"{{ with .features }}{{ with .reader_experience }}{{ if and .enabled .agent_exports }}, "Catalog", "llms"{{ end }}{{ end }}{{ end }}]

# Hugo 0.158+ default security.http.urls excludes URLs containing "@", which
# blocks Hextra's flexsearch CDN load (cdn.jsdelivr.net/npm/flexsearch@<ver>).
# Override removes that exclusion. Drop this block entirely if you disable search.
[security]
  [security.http]
    urls = ['(?i)^https?://[a-z]', '! (?i)localhost']

{{ with .features }}{{ with .reader_experience }}{{ if .enabled }}
# Reader experience (features.reader_experience). The editorial "Updated" date
# resolves from `last_updated` (which must therefore be a date on a reader
# blog), then lastmod, then date. Reader blogs only: elsewhere `last_updated`
# stays the free-text key the {{ "{{< last-updated >}}" }} shortcode prints, and
# Hugo keeps its default chain (incl. :git under enableGitInfo).
[frontmatter]
  lastmod = ["last_updated", "lastmod", "date"]

[params.reader]
  enabled = true
  agentExports = {{ if .agent_exports }}true{{ else }}false{{ end }}
{{ with .author }}
[params.reader.author]
  name = {{ quote .name }}
  url = {{ quote .url }}
{{ end }}
{{- if .agent_exports }}
# Agent exports. The catalog is blog-craft's; `llms` is Hextra's own output
# format (it defines it but does not enable it), and the feature's
# home.llms.txt overrides the theme's generic llms.txt with a catalog-first one.
# Do NOT add Hextra's `markdown` format to outputs.page: it also writes
# index.md and would race scripts/export-content.py for the same file.
[outputFormats.Catalog]
  mediaType = "application/json"
  baseName = "content-index"
  isPlainText = true
{{ end }}{{ end }}{{ end }}{{ end }}
